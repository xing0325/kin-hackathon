NODE_ENV=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/kin?ssl_verify_cert=true
DEMO_MODE=false
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_EXCHANGE_TOKEN=replace-with-independent-auth-exchange-token
TOKEN_TTL_SECONDS=86400
AGENT_GATEWAY_TOKEN=replace-with-independent-random-token
CORS_ORIGINS=https://kin.example.com
EMBEDDING_DIM=64
RELEASE_SHA=git-sha-or-build-id
